# Giới hạn file tải lên (MB) và số điểm ảnh tối đa mỗi ảnh
MAX_UPLOAD_MB=20
MAX_PIXELS=25000000
MAX_REDUNDANCY=50
# Chỉ cần khi frontend deploy ở domain khác, phân cách bằng dấu phẩy
CORS_ORIGINS=
# Thư mục frontend đã build. Để trống = tự dùng ../frontend/dist nếu có
STATIC_DIR=
# Số request POST tối đa mỗi phút cho mỗi IP (0 = tắt)
RATE_LIMIT_PER_MIN=60
# Đặt 1 để bật trang tài liệu API /api/docs (chỉ khi phát triển)
ENABLE_DOCS=
# --- Tài khoản và lịch sử ---
# Nơi chứa cơ sở dữ liệu SQLite và file người dùng đã lưu. Để trống = backend/data
DATA_DIR=
# Đặt 0 để khoá đăng ký tài khoản mới
ALLOW_REGISTRATION=1
SESSION_DAYS=30
MAX_ITEMS_PER_USER=200
MAX_STORAGE_MB_PER_USER=500
# Số lần thử đăng nhập/đăng ký mỗi phút cho mỗi IP và mỗi tên (0 = tắt)
LOGIN_ATTEMPTS_PER_MIN=10
# Cookie phiên chỉ gửi qua HTTPS: 1 luôn bật, 0 luôn tắt, để trống = tự nhận
COOKIE_SECURE=
# Số việc nặng chạy cùng lúc (mặc định = số nhân CPU, tối đa 4); yêu cầu dư ra sẽ xếp hàng
MAX_HEAVY_JOBS=
